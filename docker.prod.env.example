# Copy to repo-root `.env` (gitignored) before:
#   docker compose -f docker-compose.prod.yml --env-file .env up --build -d
#
# Replace every REPLACE_* / empty secret. Never commit the real `.env`.

# Host ports Nginx publishes (defaults 80/443). Use 8080 if 80 is taken locally.
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# ── Public URL (browser-facing) ─────────────────────────────────────────────
# VM IP or domain, no trailing slash. Used for file links and invitation emails.
PUBLIC_HOST=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost
# File URLs returned by NestJS: PUBLIC_URL + /files/<filename>
PUBLIC_URL=http://localhost/api

# Frontend REST base, baked into the Next.js image at build time.
# `/api` is same-origin via Nginx (recommended — no rebuild when the host changes).
NEXT_PUBLIC_API_URL=/api
# Leave empty unless Socket.IO must use a different origin than the page.
NEXT_PUBLIC_WS_URL=

# ── PostgreSQL (Compose service hostname is `postgres`) ─────────────────────
POSTGRES_USER=foasis
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=foasis_db
DATABASE_URL=postgresql://foasis:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/foasis_db?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
# Must be ≥32 characters and not an example/placeholder (backend refuses to start).
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_SELECTION_EXPIRES_IN=10m
ALLOW_OPEN_REGISTRATION=false

# Optional first Super Admin (skipped if unset). Password must not be a placeholder.
# SUPER_ADMIN_EMAIL=admin@example.edu
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin

# ── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=FOASIS <no-reply@foasis.app>
# EMAIL_REPLY_TO=
# EMAIL_TIMEOUT_MS=5000
# EMAIL_RETRY_COUNT=3
# EMAIL_RETRY_BASE_MS=500

# Rollback path (only if EMAIL_PROVIDER=smtp):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FOASIS <no-reply@foasis.app>

# ── Optional ────────────────────────────────────────────────────────────────
# DB_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT=20
# INVITATION_EXPIRES_HOURS=24
# AUTH_PASSWORD_MAX_LENGTH=72
# AUTH_LOGIN_RATE_LIMIT=10
# THROTTLE_LIMIT=120
# THROTTLE_TTL_MS=60000
# WS_MAX_CONNECTIONS_PER_USER=5
# ALLOW_WS_QUERY_TOKEN=false
