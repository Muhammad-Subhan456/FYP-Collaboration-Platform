# HTTPS server block — copy to conf.d/ssl.conf when the university provides
# a domain and TLS certificate. Do not enable until cert files exist.
#
# 1. Place certs on the VM, e.g. /etc/foasis/tls/fullchain.pem + privkey.pem
# 2. Uncomment the certs volume in docker-compose.prod.yml
# 3. Copy this file to deploy/nginx/conf.d/ssl.conf and rebuild/restart nginx
# 4. Optionally redirect HTTP→HTTPS in default.conf

# server {
#   listen 443 ssl;
#   http2 on;
#   server_name _;
#
#   ssl_certificate     /etc/nginx/certs/fullchain.pem;
#   ssl_certificate_key /etc/nginx/certs/privkey.pem;
#   ssl_session_timeout 1d;
#   ssl_session_cache shared:SSL:10m;
#   ssl_protocols TLSv1.2 TLSv1.3;
#
#   # Duplicate the location blocks from conf.d/default.conf here,
#   # or include a shared locations snippet.
# }
