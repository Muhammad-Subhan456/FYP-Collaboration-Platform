generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliverableType {
  SRS
  DESIGN
  MID_VIVA
  FINAL_REPORT
  PRESENTATION
  OTHER
}

enum SubmissionStatus {
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
}

enum AnnouncementType {
  GENERAL
  DEADLINE
  MEETING
  WORKSHOP
  VIVA
}

enum MeetingType {
  WEEKLY
  VIVA
  WORKSHOP
  DISCUSSION
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Meeting {
  id            String @id @default(uuid())

  supervisorId  String

  title         String

  description   String?

  type          MeetingType

  meetingDate   DateTime

  location      String?

  meetingLink   String?

  createdAt     DateTime @default(now())
}

model Announcement {
  id            String @id @default(uuid())

  supervisorId  String

  title         String

  message       String

  type          AnnouncementType @default(GENERAL)

  dueDate       DateTime?

  createdAt     DateTime @default(now())
}

model Deliverable {
  id             String @id @default(uuid())

  supervisorId   String

  title          String

  description    String

  type           DeliverableType

  dueDate        DateTime

  attachmentUrl  String?

  isActive       Boolean @default(true)

  createdAt      DateTime @default(now())

  submissions    Submission[]
}

model Submission {
  id                String @id @default(uuid())

  deliverableId     String

  teamId            String

  fileUrl           String

  remarks           String?

  status            SubmissionStatus @default(SUBMITTED)

  feedback          String?

  grade             Int?

  submittedAt       DateTime @default(now())

  deliverable       Deliverable @relation(fields: [deliverableId], references: [id])

  @@unique([deliverableId, teamId])
}

model Milestone {
  id            String @id @default(uuid())

  proposalId    String

  title         String

  description   String?

  dueDate       DateTime

  status        MilestoneStatus @default(PENDING)

  createdAt     DateTime @default(now())

  tasks         Task[]
}

model Task {
  id            String @id @default(uuid())

  milestoneId   String

  title         String

  description   String?

  assignedTo    String

  dueDate       DateTime?

  status        TaskStatus @default(TODO)

  createdAt     DateTime @default(now())

  milestone     Milestone @relation(fields: [milestoneId],references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())

  authUserId  String

  title       String

  description String?

  createdAt   DateTime @default(now())
}