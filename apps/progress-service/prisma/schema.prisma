generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliverableType {
  SRS
  DESIGN
  MID_VIVA
  FINAL_REPORT
  PRESENTATION
  OTHER
}

enum SubmissionStatus {
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
}

enum AnnouncementType {
  GENERAL
  DEADLINE
  MEETING
  WORKSHOP
  VIVA
}

enum MeetingType {
  WEEKLY
  VIVA
  WORKSHOP
  DISCUSSION
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EvaluationType {
  MID_VIVA
  FINAL_VIVA
}

model Meeting {
  id String @id @default(uuid())

  supervisorId String

  title String

  description String?

  type MeetingType

  meetingDate DateTime

  location String?

  meetingLink String?

  createdAt DateTime @default(now())
}

model Announcement {
  id String @id @default(uuid())

  supervisorId String

  title String

  message String

  type AnnouncementType @default(GENERAL)

  dueDate DateTime?

  createdAt DateTime @default(now())
}

model Deliverable {
  id String @id @default(uuid())

  supervisorId String

  title String

  description String

  type DeliverableType

  dueDate DateTime

  attachmentUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id String @id @default(uuid())

  deliverableId String

  teamId String

  version Int @default(1)

  fileUrl String

  remarks String?

  status SubmissionStatus @default(SUBMITTED)

  feedback String?

  grade Int?

  submittedAt DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId],references: [id])
}

model Milestone {
  id String @id @default(uuid())

  proposalId String

  title String

  description String?

  dueDate DateTime

  status MilestoneStatus @default(PENDING)

  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id String @id @default(uuid())

  milestoneId String

  title String

  description String?

  assignedTo String

  dueDate DateTime?

  status TaskStatus @default(TODO)

  createdAt DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id])
}

model ActivityLog {
  id String @id @default(uuid())

  authUserId String

  title String

  description String?

  createdAt DateTime @default(now())
}

model GlobalAnnouncement {
  id String @id @default(uuid())

  coordinatorId String

  title String

  message String

  createdAt DateTime @default(now())
}

model Evaluation {
  id String @id @default(uuid())

  coordinatorId String

  title String

  type EvaluationType

  date DateTime

  venue String

  remarks String?

  createdAt DateTime @default(now())

  assignments EvaluationAssignment[]

  results EvaluationResult[]

  panels EvaluationPanel[]
}

model EvaluationPanel {
  id String @id @default(uuid())

  evaluationId String

  room String

  scheduledAt DateTime?

  remarks String?

  createdAt DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  evaluators PanelEvaluator[]

  assignments EvaluationAssignment[]
}

model PanelEvaluator {
  id String @id @default(uuid())

  panelId String

  evaluatorId String

  role String @default("EVALUATOR")

  createdAt DateTime @default(now())

  panel EvaluationPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, evaluatorId])
}

model EvaluationAssignment {
  id String @id @default(uuid())

  evaluationId String

  teamId String

  panelId String?

  createdAt DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  panel EvaluationPanel? @relation(fields: [panelId], references: [id])

  @@unique([evaluationId, teamId])
}

model EvaluationResult {
  id String @id @default(uuid())

  evaluationId String

  teamId String

  marks Float

  comments String?

  createdAt DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@unique([evaluationId, teamId])
}
