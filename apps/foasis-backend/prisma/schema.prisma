generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (from auth-service) ───────────────────────────────────────────────

enum GlobalAnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum UserRole {
  STUDENT
  SUPERVISOR
  COORDINATOR
  EVALUATOR
  SUPER_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  fullName       String
  passwordHash   String?
  googleId       String?  @unique
  role           UserRole @default(STUDENT)
  isActive       Boolean  @default(true)
  /// Bumped on password change/reset so previously issued access JWTs are rejected.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships  WorkspaceMembership[]
  invitationsSent WorkspaceInvitation[] @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

model Workspace {
  id                             String   @id @default(uuid())
  name                           String
  slug                           String   @unique
  description                    String?
  coordinatorEmail               String
  isArchived                     Boolean  @default(false)
  /// Max members allowed in a team (future joins). Existing larger teams are kept.
  teamMaxMembers                 Int      @default(4)
  /// Max teams a supervisor may manage (APPROVED / SUPERVISOR_ASSIGNED).
  supervisorMaxTeams             Int      @default(4)
  /// Hours a supervisor has to accept/reject a pending team request.
  supervisorRequestExpiryHours   Int      @default(24)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  memberships                    WorkspaceMembership[]
  teams                          Team[]
  proposals                      Proposal[]
  supervisorRequests             SupervisorRequest[]
  supervisorInvitations          SupervisorInvitation[]
  notifications                  Notification[]
  announcements                  Announcement[]
  deliverables                   Deliverable[]
  submissions                    Submission[]
  submissionAttachments          SubmissionAttachment[]
  workStreamComments             WorkStreamComment[]
  workStreamAttachments          WorkStreamAttachment[]
  teamIssues                     TeamIssue[]
  teamIssueComments              TeamIssueComment[]
  teamIssueActivities            TeamIssueActivity[]
  activityLogs                   ActivityLog[]
  evaluations                    Evaluation[]
  globalAnnouncements            GlobalAnnouncement[]
  scheduledReminders             ScheduledReminder[]
  invitations                    WorkspaceInvitation[]
  phases                         Phase[]
  deliverableTemplates           DeliverableTemplate[]
  submissionEvaluations          SubmissionEvaluation[]
  studentPhaseResults            StudentPhaseResult[]

  @@index([isArchived, createdAt(sort: Desc)])
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        UserRole
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, role])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id                 String           @id @default(uuid())
  workspaceId        String
  email              String
  fullName           String?
  role               UserRole
  /// Institution-managed student fields (CSV invite prefill).
  registrationNumber String?
  batch              String?
  department         Department?
  degreeProgram      String?
  tokenHash          String           @unique
  invitedById        String
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy          User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([workspaceId, email, role, status])
  @@index([workspaceId, registrationNumber])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  plan         SubscriptionPlan @default(STARTER)
  isActive     Boolean          @default(false)
  subscribedAt DateTime?
  ownerId      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ─── Users / Profiles (from user-service) ───────────────────────────────────

enum Department {
  CS
  SE
  IT
  AI
  DS
}

enum ProfileType {
  STUDENT
  SUPERVISOR
  COORDINATOR
  EVALUATOR
}

model UserProfile {
  id                 String      @id @default(uuid())
  authUserId         String      @unique
  profileType        ProfileType @default(STUDENT)
  profilePicture     String?
  fullName           String
  email              String?
  registrationNumber String?
  department         Department?
  batch              String?
  degreeProgram      String?
  semester           Int?
  skills             String[]    @default([])
  interests          String[]    @default([])
  cgpa               Float?
  phone              String?
  linkedIn           String?
  github             String?
  bio                String?
  facultyId          String?
  designation        String?
  officeLocation     String?
  biography          String?
  researchAreas      String[]    @default([])
  publications       String[]    @default([])
  officeHours        String?
  googleScholar      String?
  coordinatorRole    String?
  contactInformation String?
  /// When true, registrationNumber/batch/department/degreeProgram are institution-managed (CSV).
  institutionManaged Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

// ─── Teams (from team-service) ────────────────────────────────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Team {
  id                 String   @id @default(uuid())
  workspaceId        String
  name               String
  domain             String
  domains            String[] @default([])
  otherDomain        String?
  nature             ProjectNature?
  sdgs               Int[]    @default([])
  sdgJustification   String?
  previousObjectives String?
  projectTitle       String?
  projectAbstract    String?
  proposalPdfUrl     String?
  maxMembers         Int
  leaderId           String
  isOpen             Boolean  @default(true)
  createdAt          DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  members         TeamMember[]
  joinRequests    JoinRequest[]
  proposal        Proposal?

  @@index([workspaceId, isOpen])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String
  authUserId String
  teamRole   String?
  joinedAt   DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@unique([teamId, authUserId])
  @@index([authUserId])
}

model JoinRequest {
  id         String            @id @default(uuid())
  teamId     String
  authUserId String
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  team       Team              @relation(fields: [teamId], references: [id])
  @@unique([teamId, authUserId])
  @@index([teamId])
}

// ─── Proposals (from proposal-service) ────────────────────────────────────

enum ProposalStatus {
  DRAFT
  PENDING_SUPERVISOR
  SUPERVISOR_ASSIGNED
  APPROVED
  REJECTED
  IGNORED
}

enum ProjectNature {
  DEVELOPMENT
  RESEARCH_AND_DEVELOPMENT
  HYBRID
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IGNORED
  CANCELLED
}

model Proposal {
  id                   String         @id @default(uuid())
  teamId               String         @unique
  workspaceId          String
  teamLeaderAuthUserId String?
  projectCode          String?        @unique
  title                String
  domain               String
  domains              String[]       @default([])
  otherDomain          String?
  nature               ProjectNature?
  sdgs                 Int[]          @default([])
  sdgJustification     String?
  previousObjectives   String?
  abstract             String
  proposalPdfUrl       String?
  status               ProposalStatus @default(DRAFT)
  assignedSupervisorId String?
  pendingSupervisorId  String?
  pendingExpiresAt     DateTime?
  reviewFeedback       String?
  reviewedAt           DateTime?
  reviewedById         String?
  createdAt            DateTime       @default(now())
  team                 Team           @relation(fields: [teamId], references: [id])
  workspace            Workspace      @relation(fields: [workspaceId], references: [id])
  supervisorRequests   SupervisorRequest[]
  supervisorInvitations SupervisorInvitation[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([assignedSupervisorId, status])
  @@index([pendingSupervisorId, status])
}

model SupervisorRequest {
  id              String        @id @default(uuid())
  proposalId      String
  workspaceId     String
  supervisorId    String
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  expiresAt       DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  proposal        Proposal      @relation(fields: [proposalId], references: [id])
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([proposalId, status])
  @@index([status, expiresAt])
  @@index([proposalId, supervisorId])
}

model SupervisorInvitation {
  id           String        @id @default(uuid())
  proposalId   String?
  teamId       String?
  workspaceId  String
  supervisorId String
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  proposal     Proposal?     @relation(fields: [proposalId], references: [id])
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([proposalId, supervisorId])
  @@index([teamId, supervisorId])
}

// ─── Notifications (from notification-service) ────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  workspaceId String
  authUserId String
  title      String
  message    String
  type       String?
  entityType String?
  entityId   String?
  route      String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, authUserId, createdAt(sort: Desc)])
  @@index([authUserId, createdAt(sort: Desc)])
  @@index([authUserId, isRead])
}

// ─── Progress (from progress-service) ─────────────────────────────────────

enum DeliverableType {
  SRS
  DESIGN
  MID_VIVA
  FINAL_REPORT
  PRESENTATION
  OTHER
}

enum SubmissionStatus {
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
  FINALIZED
}

enum PhaseStatus {
  ACTIVE
  INACTIVE
  PUBLISHED
}

enum SubmissionEvaluationStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
}

enum AnnouncementType {
  GENERAL
  DEADLINE
  MEETING
  WORKSHOP
  VIVA
}

enum TeamIssueStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  ARCHIVED
}

enum TeamIssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum TeamIssueActivityType {
  CREATED
  CLAIMED
  RELEASED
  COMPLETED
  COMMENTED
  UPDATED
}

enum EvaluationType {
  MID_VIVA
  FINAL_VIVA
}

model Announcement {
  id           String           @id @default(uuid())
  workspaceId   String
  supervisorId String
  teamId       String?
  title        String
  message      String
  type         AnnouncementType @default(GENERAL)
  dueDate      DateTime?
  createdAt    DateTime         @default(now())
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([supervisorId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
}

model Phase {
  id           String      @id @default(uuid())
  workspaceId  String
  name         String
  creditHours  Int
  description  String?
  status       PhaseStatus @default(ACTIVE)
  sortOrder    Int         @default(0)
  isConfigurationPublished Boolean @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates    DeliverableTemplate[]
  deliverables Deliverable[]
  studentResults StudentPhaseResult[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status, sortOrder])
}

model DeliverableTemplate {
  id             String          @id @default(uuid())
  workspaceId    String
  phaseId        String
  coordinatorId  String
  title          String
  description    String
  type           DeliverableType
  dueDate        DateTime?
  totalMarks     Int
  weightagePercent Decimal       @default(0) @db.Decimal(5, 2)
  isLocked       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phase          Phase           @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  rubricCriteria RubricCriterion[]
  attachments    DeliverableTemplateAttachment[]
  deliverables   Deliverable[]
  submissionEvaluations SubmissionEvaluation[]

  @@index([workspaceId, phaseId])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model RubricCriterion {
  id          String              @id @default(uuid())
  templateId  String
  title       String
  description String?
  maxMarks    Int
  sortOrder   Int                 @default(0)
  template    DeliverableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criterionScores SubmissionCriterionScore[]

  @@index([templateId, sortOrder])
}

model DeliverableTemplateAttachment {
  id         String              @id @default(uuid())
  templateId String
  fileUrl    String
  fileName   String
  createdAt  DateTime            @default(now())
  template   DeliverableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Deliverable {
  id                 String   @id @default(uuid())
  workspaceId         String
  supervisorId       String
  teamId             String?
  phaseId            String
  templateId         String?
  title              String
  description        String
  type               DeliverableType
  dueDate            DateTime
  totalMarks         Int?
  attachmentUrl      String?
  isActive           Boolean  @default(true)
  submissionsOpen    Boolean  @default(true)
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  phase              Phase    @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  template           DeliverableTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  submissions        Submission[]
  deadlineExtensions DeliverableDeadlineExtension[]
  submissionEvaluations SubmissionEvaluation[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([supervisorId, isActive, dueDate])
  @@index([teamId, dueDate])
  @@index([phaseId, dueDate])
  @@index([templateId])
  @@unique([templateId, teamId])
}

model DeliverableDeadlineExtension {
  id              String      @id @default(uuid())
  deliverableId   String
  previousDueDate DateTime
  newDueDate      DateTime
  extendedBy      String
  reason          String?
  createdAt       DateTime    @default(now())
  deliverable     Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
}

model Submission {
  id            String           @id @default(uuid())
  workspaceId    String
  deliverableId String
  teamId        String
  version       Int              @default(1)
  fileUrl       String
  remarks       String?
  status        SubmissionStatus @default(SUBMITTED)
  feedback      String?
  grade         Int?
  submittedAt   DateTime         @default(now())
  finalizedAt   DateTime?
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id])
  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  evaluations   SubmissionEvaluation[]
  attachments   SubmissionAttachment[]

  @@index([workspaceId, submittedAt(sort: Desc)])
  @@index([teamId, status])
  @@index([teamId, deliverableId, version(sort: Desc)])
}

model SubmissionAttachment {
  id           String     @id @default(uuid())
  workspaceId  String
  submissionId String
  fileUrl      String
  fileName     String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([submissionId, createdAt])
}

enum WorkStreamEntityType {
  ANNOUNCEMENT
  DELIVERABLE
}

model WorkStreamComment {
  id         String               @id @default(uuid())
  workspaceId String
  entityType WorkStreamEntityType
  entityId   String
  teamId     String
  authUserId String
  body       String
  createdAt  DateTime             @default(now())
  workspace  Workspace            @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt])
}

model WorkStreamAttachment {
  id         String               @id @default(uuid())
  workspaceId String
  entityType WorkStreamEntityType
  entityId   String
  teamId     String
  fileUrl    String
  fileName   String
  createdAt  DateTime             @default(now())
  workspace  Workspace            @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model TeamIssue {
  id              String            @id @default(uuid())
  workspaceId     String
  teamId          String
  title           String
  description     String
  priority        TeamIssuePriority @default(MEDIUM)
  labels          String[]          @default([])
  status          TeamIssueStatus   @default(OPEN)
  assignedToId    String?
  githubPrUrl     String?
  githubCommitUrl String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?
  comments        TeamIssueComment[]
  activities      TeamIssueActivity[]
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([assignedToId, status])
}

model TeamIssueComment {
  id         String    @id @default(uuid())
  workspaceId String
  issueId    String
  teamId     String
  authUserId String
  body       String
  createdAt  DateTime  @default(now())
  issue      TeamIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([issueId, createdAt])
}

model TeamIssueActivity {
  id          String                @id @default(uuid())
  workspaceId String
  issueId     String
  teamId      String
  actorId     String
  type        TeamIssueActivityType
  description String?
  createdAt   DateTime              @default(now())
  issue       TeamIssue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([issueId, createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId  String
  authUserId  String
  title       String
  description String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([authUserId, createdAt(sort: Desc)])
}

model GlobalAnnouncement {
  id            String                   @id @default(uuid())
  workspaceId   String
  coordinatorId String
  title         String
  message       String
  type          AnnouncementType         @default(GENERAL)
  audienceRoles String[]
  publishAt     DateTime?
  publishedAt   DateTime?
  status        GlobalAnnouncementStatus @default(PUBLISHED)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  workspace     Workspace                @relation(fields: [workspaceId], references: [id])
  attachments   GlobalAnnouncementAttachment[]

  @@index([workspaceId, status, publishAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model GlobalAnnouncementAttachment {
  id             String             @id @default(uuid())
  announcementId String
  fileUrl        String
  fileName       String
  createdAt      DateTime           @default(now())
  announcement   GlobalAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model ScheduledReminder {
  id           String         @id @default(uuid())
  workspaceId  String
  reminderType String
  entityType   String?
  entityId     String?
  title        String
  message      String
  route        String?
  channels     String[]       @default(["notification"])
  audienceSpec Json?
  scheduledFor DateTime
  status       ReminderStatus @default(PENDING)
  sentAt       DateTime?
  lastError    String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([workspaceId, reminderType])
}

model Evaluation {
  id            String         @id @default(uuid())
  workspaceId   String
  coordinatorId String
  title         String
  type          EvaluationType
  date          DateTime
  venue         String
  remarks       String?
  createdAt     DateTime       @default(now())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  assignments   EvaluationAssignment[]
  results       EvaluationResult[]
  panels        EvaluationPanel[]

  @@index([workspaceId, date])
}

model EvaluationPanel {
  id           String   @id @default(uuid())
  evaluationId String
  room         String
  scheduledAt  DateTime?
  remarks      String?
  createdAt    DateTime @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluators   PanelEvaluator[]
  assignments  EvaluationAssignment[]
}

model PanelEvaluator {
  id          String   @id @default(uuid())
  panelId     String
  evaluatorId String
  role        String   @default("EVALUATOR")
  createdAt   DateTime @default(now())
  panel       EvaluationPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  @@unique([panelId, evaluatorId])
}

model EvaluationAssignment {
  id           String   @id @default(uuid())
  evaluationId String
  teamId       String
  panelId      String?
  createdAt    DateTime @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  panel        EvaluationPanel? @relation(fields: [panelId], references: [id])
  @@unique([evaluationId, teamId])
  @@index([teamId])
}

model EvaluationResult {
  id           String   @id @default(uuid())
  evaluationId String
  teamId       String
  marks        Float
  comments     String?
  createdAt    DateTime @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  @@unique([evaluationId, teamId])
  @@index([teamId, createdAt(sort: Desc)])
}

model SubmissionEvaluation {
  id            String                     @id @default(uuid())
  workspaceId   String
  submissionId  String
  deliverableId String
  teamId        String
  templateId    String
  evaluatorId   String
  assignedById  String
  status        SubmissionEvaluationStatus @default(ASSIGNED)
  submittedAt   DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submission    Submission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  deliverable   Deliverable                @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  template      DeliverableTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  studentScores StudentSubmissionEvaluation[]

  @@unique([submissionId, evaluatorId])
  @@index([workspaceId, evaluatorId, status])
  @@index([workspaceId, teamId])
  @@index([deliverableId, status])
  @@index([templateId, teamId])
}

model StudentSubmissionEvaluation {
  id                     String   @id @default(uuid())
  submissionEvaluationId String
  studentId              String
  totalMarks             Float
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  submissionEvaluation   SubmissionEvaluation @relation(fields: [submissionEvaluationId], references: [id], onDelete: Cascade)
  criterionScores        SubmissionCriterionScore[]

  @@unique([submissionEvaluationId, studentId])
  @@index([studentId])
}

model SubmissionCriterionScore {
  id                          String @id @default(uuid())
  studentSubmissionEvaluationId String
  rubricCriterionId           String
  marksAwarded                Float
  studentSubmissionEvaluation StudentSubmissionEvaluation @relation(fields: [studentSubmissionEvaluationId], references: [id], onDelete: Cascade)
  rubricCriterion             RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Restrict)

  @@unique([studentSubmissionEvaluationId, rubricCriterionId])
}

model StudentPhaseResult {
  id               String   @id @default(uuid())
  workspaceId      String
  phaseId          String
  studentId        String
  weightedMarks    Float
  basePercentage   Float?
  gpa              Float
  isComplete       Boolean  @default(false)
  promotionApplied Boolean  @default(false)
  promotedById     String?
  promotedAt       DateTime?
  breakdown        Json?
  calculatedAt     DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phase            Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, studentId])
  @@index([workspaceId, studentId])
  @@index([phaseId, isComplete])
}
