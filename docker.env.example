# Copy to apps/foasis-backend/.env before: docker compose up --build
#
# This file is for LOCAL compose (docker-compose.yml): frontend :3007 + backend :3000.
# Database is external (Supabase or any PostgreSQL reachable from the host).
#
# University VM / Nginx + container Postgres: use docker.prod.env.example instead.

# Supabase (Session pooler, port 5432) — or any external Postgres URL
# Session mode often caps at ~15 clients. PrismaService appends
# connection_limit=5&pool_timeout=20 unless already present.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public
# DB_CONNECTION_LIMIT=5
# DB_POOL_TIMEOUT=20

# Generate a unique secret (e.g. openssl rand -base64 48). Never use placeholders in production.
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_SELECTION_EXPIRES_IN=10m

# Used by docker-compose.yml for upload URLs returned to the browser
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3007
CORS_ORIGIN=http://localhost:3007

ALLOW_OPEN_REGISTRATION=false

# ── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=FOASIS <no-reply@foasis.app>
# EMAIL_REPLY_TO=
# EMAIL_TIMEOUT_MS=5000
# EMAIL_RETRY_COUNT=3
# EMAIL_RETRY_BASE_MS=500

# Rollback path (inactive unless EMAIL_PROVIDER=smtp):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FOASIS <no-reply@foasis.app>

# Auth / throttling (optional overrides)
# AUTH_PASSWORD_MAX_LENGTH=72
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_BACKOFF_BASE_MS=2000
# THROTTLE_LIMIT=120
# THROTTLE_TTL_MS=60000
# WS_MAX_CONNECTIONS_PER_USER=5
# ALLOW_WS_QUERY_TOKEN=false

# NEXT_PUBLIC_API_URL is a frontend image build arg in docker-compose.yml
# Local default: http://localhost:3000
